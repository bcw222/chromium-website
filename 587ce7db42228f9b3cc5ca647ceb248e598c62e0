      },
      "lineNbr": 11,
      "author": {
        "id": 1255370
      },
      "writtenOn": "2023-04-25T19:01:32Z",
      "side": 1,
      "message": "all references to coreboot should be lower case",
      "range": {
        "startLine": 11,
        "startChar": 51,
        "endLine": 11,
        "endChar": 59
      },
      "revId": "587ce7db42228f9b3cc5ca647ceb248e598c62e0",
