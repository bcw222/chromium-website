      },
      "lineNbr": 12,
      "author": {
        "id": 1255370
      },
      "writtenOn": "2023-04-25T19:01:32Z",
      "side": 1,
      "message": "I\u0027d avoid using BIOS as a term for system firmware, in order to not muddy things. ChromeOS firmware is neither BIOS nor UEFI, a point that is often unclear.",
      "range": {
        "startLine": 12,
        "startChar": 0,
        "endLine": 12,
        "endChar": 4
      },
      "revId": "587ce7db42228f9b3cc5ca647ceb248e598c62e0",
