      "author": {
        "id": 1255370
      },
      "writtenOn": "2023-04-25T19:01:32Z",
      "side": 1,
      "message": "I feel like backing up internally is sufficient here. The parts which can\u0027t be read also can\u0027t be written, so when recovering from a failed flash the user only needs to flash the BIOS region anyway",
      "parentUuid": "c50b37a5_3e43a736",
      "range": {
        "startLine": 75,
        "startChar": 2,
        "endLine": 75,
        "endChar": 54
      },
      "revId": "587ce7db42228f9b3cc5ca647ceb248e598c62e0",
