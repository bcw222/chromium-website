[access]
	inheritFrom = All-Projects
[submit]
	action = inherit
[access "refs/*"]
	owner = group mdb/chrome-git-admins
	label-Code-Review = -1..+1 group chromium-website-committers
	submit = group chromium-website-committers
[access "refs/for/*"]
	create = group Logged-in Public Users
	push = group Logged-in Public Users
